exit: Some(0)
--- stdout ---
query aws_secrets_manager_python_sdk_call($path: String!) {
  sourceReads(path: $path, language: PYTHON, redactArgValues: true, filters: [{ callees: ["get_secret_value"], importHints: ["boto3", "secretsmanager"] }]) {
    schema
    argValuesRedacted
    sourceReads {
      filePath
      lineNumber
      column
      sourceId
      sourceCategory
      providerId
      sdk
      envVarName
      keyName
      accessPath
      readText
      importEvidence
    }
    exitStatus
  }
}


